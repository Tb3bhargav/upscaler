{
  "manifest_version": 3,
  "name": "IBP DCCI Upscaler Sidebar",
  "version": "1.0.0",
  "description": "Local high-fidelity image upscaler powered by IBP + DCCI + Guided Filter.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open IBP DCCI Upscaler"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
